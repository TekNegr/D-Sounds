<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dsounds.controllers.ListController"
            style="-fx-background-color: #1a1a2e;">

    <!-- HAUT : barre de recherche et navigation -->
    <top>
        <VBox spacing="8.0" style="-fx-background-color: #16213e; -fx-padding: 12 20 10 20;">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="🎵 Bibliothèque"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" />
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Retour" onAction="#switchToDashboard"
                        style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-padding: 4 12; -fx-background-radius: 6;"/>
            </HBox>
            <HBox spacing="8.0">
                <TextField fx:id="searchField"
                           promptText="Rechercher par titre, artiste, genre..."
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-prompt-text-fill: #aaa; -fx-background-radius: 6; -fx-padding: 6 10;"/>
                <Button fx:id="clearSearchButton" text="✕" onAction="#clearSearch"
                        style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-background-radius: 6;"/>
                <Button text="⟳" onAction="#refreshSongs"
                        style="-fx-background-color: #0f3460; -fx-text-fill: white; -fx-background-radius: 6;"/>
                <Button fx:id="editSongButton" text="✏ Modifier" onAction="#editSelectedSong" disable="true"
                        style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 4 10;"/>
            </HBox>
            <Label fx:id="songCountLabel" text=""
                   style="-fx-text-fill: #aaa; -fx-font-size: 11px;"/>
        </VBox>
    </top>

    <!-- GAUCHE : liste des morceaux -->
    <left>
        <VBox style="-fx-background-color: #16213e; -fx-border-color: #0f3460; -fx-border-width: 0 1 0 0;"
              prefWidth="280">
            <ListView fx:id="songListView" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: transparent; -fx-text-fill: white;
                             -fx-control-inner-background: #16213e;"/>
            <padding><Insets top="8" right="0" bottom="8" left="0"/></padding>
        </VBox>
    </left>

    <!-- CENTRE : pochette + lecteur + détails -->
    <center>
        <VBox spacing="0" style="-fx-background-color: #1a1a2e;">

            <!-- Pochette grande -->
            <StackPane style="-fx-background-color: #0f3460; -fx-min-height: 260; -fx-max-height: 260;"
                       alignment="CENTER">
                <ImageView fx:id="coverImageView" fitWidth="240" fitHeight="240"
                           preserveRatio="true"/>
            </StackPane>

            <!-- Titre + artiste du morceau en cours -->
            <VBox spacing="2" style="-fx-padding: 12 20 6 20; -fx-background-color: #16213e;">
                <Label fx:id="nowPlayingTitle" text="Sélectionnez un morceau"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label fx:id="nowPlayingArtist" text=""
                       style="-fx-font-size: 12px; -fx-text-fill: #aaa;"/>
            </VBox>

            <!-- Barre de progression -->
            <VBox spacing="2" style="-fx-padding: 0 20 4 20; -fx-background-color: #16213e;">
                <Slider fx:id="progressSlider" min="0" max="1" value="0"
                        style="-fx-accent: #e94560;"/>
                <HBox>
                    <Label fx:id="currentTimeLabel" text="00:00"
                           style="-fx-text-fill: #aaa; -fx-font-size: 10px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="totalTimeLabel" text="00:00"
                           style="-fx-text-fill: #aaa; -fx-font-size: 10px;"/>
                </HBox>
            </VBox>

            <!-- Boutons de contrôle stylisés sous la pochette -->
            <HBox spacing="16" alignment="CENTER"
                  style="-fx-padding: 10 20 14 20; -fx-background-color: #16213e;">
                <Button fx:id="prevButton" text="⏮" onAction="#playPrevious" disable="true"
                        style="-fx-background-color: transparent; -fx-text-fill: white;
                               -fx-font-size: 20px; -fx-cursor: hand;"/>
                <Button text="▶ Écouter" onAction="#playSelectedSong"
                        style="-fx-background-color: #e94560; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-padding: 8 22;
                               -fx-background-radius: 24; -fx-font-size: 13px; -fx-cursor: hand;"/>
                <Button fx:id="pauseButton" text="⏸" onAction="#togglePause" disable="true"
                        style="-fx-background-color: transparent; -fx-text-fill: white;
                               -fx-font-size: 20px; -fx-cursor: hand;"/>
                <Button text="⏹" onAction="#stopPlayback"
                        style="-fx-background-color: transparent; -fx-text-fill: #aaa;
                               -fx-font-size: 20px; -fx-cursor: hand;"/>
                <Button fx:id="nextButton" text="⏭" onAction="#playNext" disable="true"
                        style="-fx-background-color: transparent; -fx-text-fill: white;
                               -fx-font-size: 20px; -fx-cursor: hand;"/>
            </HBox>

            <!-- Status -->
            <Label fx:id="statusLabel" text="" wrapText="true"
                   style="-fx-text-fill: #e94560; -fx-font-size: 11px; -fx-padding: 0 20 4 20;
                          -fx-background-color: #16213e;"/>

            <!-- Détails du morceau + avis -->
            <VBox spacing="8" VBox.vgrow="ALWAYS"
                  style="-fx-padding: 10 20 16 20; -fx-background-color: #1a1a2e;">
                <TextArea fx:id="songDetailsArea" editable="false" wrapText="true"
                          prefRowCount="5" VBox.vgrow="ALWAYS"
                          style="-fx-background-color: #16213e; -fx-text-fill: #ccc;
                                 -fx-control-inner-background: #16213e; -fx-border-color: #0f3460;
                                 -fx-border-radius: 6; -fx-background-radius: 6;"/>

                <!-- Avis -->
                <Label text="Avis"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label fx:id="reviewStatsLabel" text=""
                       style="-fx-text-fill: #e94560; -fx-font-style: italic; -fx-font-size: 11px;"/>
                <HBox spacing="8">
                    <Button fx:id="likeButton" text="👍 J'aime" onAction="#likeSelectedSong"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white;
                                   -fx-background-radius: 6; -fx-padding: 4 12;"/>
                    <Button fx:id="dislikeButton" text="👎 Je n'aime pas" onAction="#dislikeSelectedSong"
                            style="-fx-background-color: #c0392b; -fx-text-fill: white;
                                   -fx-background-radius: 6; -fx-padding: 4 12;"/>
                </HBox>
                <TextArea fx:id="reviewCommentArea"
                          promptText="Laisser un commentaire (140 caractères max)..."
                          prefRowCount="2" wrapText="true"
                          style="-fx-background-color: #16213e; -fx-text-fill: white;
                                 -fx-control-inner-background: #16213e; -fx-border-color: #0f3460;
                                 -fx-border-radius: 6; -fx-background-radius: 6;
                                 -fx-prompt-text-fill: #888;"/>
            </VBox>
        </VBox>
    </center>

</BorderPane>
