<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dsounds.controllers.AdminStatsController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="Statistics"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button text="Refresh" onAction="#refresh" />
            <Button text="← Back" onAction="#backToDashboard" styleClass="button-secondary" />
        </HBox>

        <GridPane hgap="20.0" vgap="12.0">
            <Label text="Users" style="-fx-font-size: 16px; -fx-font-weight: bold;"
                   GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2" />
            <Label text="Total users:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Label fx:id="totalUsersLabel" text="0" style="-fx-font-weight: bold;"
                   GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="Subscribers:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Label fx:id="subscribersLabel" text="0" style="-fx-font-weight: bold;"
                   GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Label text="Admins:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <Label fx:id="adminsLabel" text="0" style="-fx-font-weight: bold;"
                   GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label text="Suspended:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
            <Label fx:id="suspendedLabel" text="0" style="-fx-font-weight: bold; -fx-text-fill: orange;"
                   GridPane.columnIndex="1" GridPane.rowIndex="4" />

            <Label text="Catalogue" style="-fx-font-size: 16px; -fx-font-weight: bold;"
                   GridPane.columnIndex="0" GridPane.rowIndex="6" GridPane.columnSpan="2" />
            <Label text="Total songs:" GridPane.columnIndex="0" GridPane.rowIndex="7" />
            <Label fx:id="totalSongsLabel" text="0" style="-fx-font-weight: bold;"
                   GridPane.columnIndex="1" GridPane.rowIndex="7" />
            <Label text="Total albums:" GridPane.columnIndex="0" GridPane.rowIndex="8" />
            <Label fx:id="totalAlbumsLabel" text="0" style="-fx-font-weight: bold;"
                   GridPane.columnIndex="1" GridPane.rowIndex="8" />
            <Label text="Total playlists:" GridPane.columnIndex="0" GridPane.rowIndex="9" />
            <Label fx:id="totalPlaylistsLabel" text="0" style="-fx-font-weight: bold;"
                   GridPane.columnIndex="1" GridPane.rowIndex="9" />
            <Label text="Unique artists:" GridPane.columnIndex="0" GridPane.rowIndex="10" />
            <Label fx:id="uniqueArtistsLabel" text="0" style="-fx-font-weight: bold;"
                   GridPane.columnIndex="1" GridPane.rowIndex="10" />
            <Label text="Unique genres:" GridPane.columnIndex="0" GridPane.rowIndex="11" />
            <Label fx:id="uniqueGenresLabel" text="0" style="-fx-font-weight: bold;"
                   GridPane.columnIndex="1" GridPane.rowIndex="11" />
        </GridPane>
    </children>
</VBox>