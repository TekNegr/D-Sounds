<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dsounds.controllers.GlobalBarController"
      spacing="8"
      styleClass="global-bar"
      alignment="CENTER_LEFT">

    <children>
        <Label text="dSounds" styleClass="global-brand" />

        <Button text="Home" onAction="#goHome" />
        <Button fx:id="playlistsButton" text="Playlists" onAction="#goPlaylists" />
        <Button fx:id="uploadButton" text="Upload" onAction="#goUpload" />
        <Button fx:id="usersButton" text="Users" onAction="#goUsers" />
        <Button fx:id="statsButton" text="Stats" onAction="#goStats" />

        <Region HBox.hgrow="ALWAYS" />

        <Button text="Prev" onAction="#previousTrack" />
        <Button fx:id="playPauseButton" text="Pause" onAction="#togglePlayPause" />
        <Button text="Next" onAction="#nextTrack" />

        <Label fx:id="nowPlayingLabel" text="Now playing: nothing" styleClass="global-now-playing" />

        <Region HBox.hgrow="ALWAYS" />

        <Label fx:id="connectedUserLabel" text="Connected: -" styleClass="global-user-label" />
        <Button text="Logout" onAction="#logout" />
    </children>

    <padding>
        <Insets top="8" right="12" bottom="8" left="12" />
    </padding>
</HBox>
