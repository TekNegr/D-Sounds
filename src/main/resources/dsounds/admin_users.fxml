<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dsounds.controllers.AdminUsersController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="Manage Users"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button text="← Back" onAction="#backToDashboard" styleClass="button-secondary" />
        </HBox>

        <Label fx:id="statusLabel" text=""
               style="-fx-text-fill: green;" />

        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                <Label text="All Users:" style="-fx-font-weight: bold;" />
                <ListView fx:id="userListView" VBox.vgrow="ALWAYS" />
                <Button text="Refresh" onAction="#refreshList" />
            </VBox>

            <VBox fx:id="detailPane" spacing="10.0" minWidth="280.0">
                <Label text="User Details" style="-fx-font-weight: bold;" />
                <Label fx:id="detailUsername" text="" />
                <Label fx:id="detailEmail" text="" />
                <Label fx:id="detailRole" text="" />
                <Label fx:id="detailStatus" text="" />
                <Label fx:id="detailCreated" text="" />

                <HBox spacing="10.0">
                    <Button fx:id="btnSuspend" text="Suspend" onAction="#suspendUser" />
                    <Button fx:id="btnReactivate" text="Reactivate" onAction="#reactivateUser" />
                </HBox>
                <Button fx:id="btnDelete" text="Delete User" onAction="#deleteUser" styleClass="button-danger" />
            </VBox>
        </HBox>
    </children>
</VBox>