<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dsounds.controllers.DashboardController">
   <children>
      <Label text="Dashboard" style="-fx-font-size: 22px; -fx-font-weight: bold;" />
      <Button text="Open Music Browser" onAction="#switchToBrowser" />
      <Button text="Open Artist Upload Page" onAction="#switchToArtist" />
      <Button text="Open Local Song Library" onAction="#switchToList" />
      <Button text="Open Playlists" onAction="#switchToPlaylists" />
      <Button text="Logout" onAction="#logout" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
