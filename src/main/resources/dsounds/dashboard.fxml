<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>

<!--
    dashboard.fxml — Tableau de bord principal.
    Modifié par Laksman : boutons contrôlés par rôle.
-->
<VBox alignment="CENTER" spacing="14.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dsounds.controllers.DashboardController">
   <children>
      <Label fx:id="welcomeLabel" text="Tableau de bord"
             style="-fx-font-size: 22px; -fx-font-weight: bold;" />

      <Label fx:id="roleInfoLabel" text="" wrapText="true"
             style="-fx-text-fill: #555; -fx-font-style: italic;" maxWidth="420" />

      <Separator />

      <Button text="Parcourir la musique" onAction="#switchToBrowser" minWidth="240" />
      <Button text="Bibliothèque de morceaux" onAction="#switchToList" minWidth="240" />

      <!-- Réservé aux abonnés et admins (Laksman) -->
      <Button fx:id="playlistButton" text="Mes playlists"
              onAction="#switchToPlaylists" minWidth="240" />

      <Separator />

      <!-- Réservé aux admins (Laksman) -->
      <Button fx:id="artistUploadButton" text="Ajouter un morceau (artiste)"
              onAction="#switchToArtist" minWidth="240" />

      <!-- Panel admin (Laksman) -->
      <Button fx:id="adminPanelButton" text="⚙ Administration — Gérer les utilisateurs"
              onAction="#switchToAdmin" minWidth="240"
              style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold;" />

      <Separator />

      <Button text="Se déconnecter" onAction="#logout" minWidth="240"
              style="-fx-text-fill: #c0392b;" />
   </children>
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
</VBox>
