<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dsounds.controllers.ArtistController">
    <children>
        <Label text="Artist Upload Page" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <TextField fx:id="titleField" promptText="Song title" />
        <TextField fx:id="artistField" promptText="Artist name" />
        <TextField fx:id="genreField" promptText="Genre" />

        <HBox spacing="8.0">
            <children>
                <Label text="Album:" />
                <ComboBox fx:id="albumComboBox" editable="true" prefWidth="240.0" promptText="Select or type an album" />
            </children>
        </HBox>

        <HBox spacing="8.0">
            <children>
                <Label text="Publisher:" />
                <Label fx:id="publisherLabel" text="-" />
            </children>
        </HBox>

        <TextArea fx:id="descriptionArea" promptText="Description" prefRowCount="3" wrapText="true" />
        <TextArea fx:id="lyricsArea" promptText="Lyrics" prefRowCount="8" wrapText="true" />

        <HBox spacing="8.0">
            <children>
                <Button text="Choose Audio" onAction="#chooseSongFile" />
                <Label fx:id="selectedFileLabel" text="No file selected" />
            </children>
        </HBox>

        <HBox spacing="8.0">
            <children>
                <Button text="Choose Cover" onAction="#chooseCoverImage" />
                <Label fx:id="selectedCoverLabel" text="No cover selected" />
            </children>
        </HBox>

        <Button text="Save Song Locally" onAction="#saveSongLocally" />
        <Label fx:id="statusLabel" text="" />

        <Button text="Back to Dashboard" onAction="#switchToDashboard" />
    </children>

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
